<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ASSMS authenticated performance suite" enabled="true">
      <stringProp name="TestPlan.comments">Authenticated reads across Customer/Asset, Job, Dispatch and Reporting services. Job creation is disabled unless the runner explicitly supplies enable_job_create=true for the capped transactional profile.</stringProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="Runtime properties"><collectionProp name="Arguments.arguments"/></elementProp>
    </TestPlan>
    <hashTree>
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="JSON headers" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Accept</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
          <elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Authentication burst" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Login loops"><stringProp name="LoopController.loops">${__P(auth_loops,2)}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(auth_users,5)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp_up,5)}</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST auth login" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(customer_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(customer_port,5037)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/auth/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;identifier&quot;:&quot;${__P(login_identifier)}&quot;,&quot;password&quot;:&quot;${__P(login_password)}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Login returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Authenticated business reads" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="One sign-in"><stringProp name="LoopController.loops">1</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(users,5)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp_up,5)}</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST sign in for business workload" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(customer_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(customer_port,5037)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/auth/login</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;identifier&quot;:&quot;${__P(login_identifier)}&quot;,&quot;password&quot;:&quot;${__P(login_password)}&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Business login returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract bearer token" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">accessToken</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.accessToken</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">MISSING_TOKEN</stringProp></JSONPostProcessor><hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JWT was returned" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (vars.get('accessToken') == 'MISSING_TOKEN') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Login response did not contain accessToken') }</stringProp></JSR223Assertion><hashTree/>
        </hashTree>
        <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer token" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${accessToken}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="Business API mix" enabled="true"><stringProp name="LoopController.loops">${__P(loops,2)}</stringProp><boolProp name="LoopController.continue_forever">false</boolProp></LoopController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET authenticated identity" enabled="true"><stringProp name="HTTPSampler.domain">${__P(customer_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(customer_port,5037)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/auth/me</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Identity returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET customers" enabled="true"><stringProp name="HTTPSampler.domain">${__P(customer_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(customer_port,5037)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/customers</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Customers returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="Optional capped transactional workflow" enabled="true"><stringProp name="IfController.condition">${__P(enable_job_create,false)}</stringProp><stringProp name="IfController.evaluateAll">false</stringProp></IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST create controlled load-test job" enabled="true">
              <stringProp name="HTTPSampler.domain">${__P(job_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(job_port,5252)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/jobs</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;customerId&quot;:&quot;${__P(test_customer_id)}&quot;,&quot;assetId&quot;:&quot;${__P(test_asset_id)}&quot;,&quot;serviceCategory&quot;:&quot;INSPECTION&quot;,&quot;problemDescription&quot;:&quot;PERF-TEST ${__UUID()}&quot;,&quot;priority&quot;:&quot;LOW&quot;,&quot;region&quot;:&quot;WESTERN&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Job creation returns 201" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">201</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract created job ID" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">createdJobId</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">MISSING_JOB_ID</stringProp></JSONPostProcessor><hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Created job ID was returned" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">if (vars.get('createdJobId') == 'MISSING_JOB_ID') { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Job creation response did not contain id') }</stringProp></JSR223Assertion><hashTree/>
            </hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET newly created job" enabled="true"><stringProp name="HTTPSampler.domain">${__P(job_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(job_port,5252)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/jobs/${createdJobId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
            <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Created job can be read" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET jobs" enabled="true"><stringProp name="HTTPSampler.domain">${__P(job_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(job_port,5252)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/jobs</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Jobs returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET technicians" enabled="true"><stringProp name="HTTPSampler.domain">${__P(dispatch_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(dispatch_port,5055)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/technicians</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Technicians returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET jobs by status report" enabled="true"><stringProp name="HTTPSampler.domain">${__P(reporting_host,127.0.0.1)}</stringProp><stringProp name="HTTPSampler.port">${__P(reporting_port,5238)}</stringProp><stringProp name="HTTPSampler.protocol">${__P(protocol,http)}</stringProp><stringProp name="HTTPSampler.path">/api/reports/jobs-by-status</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Report returns 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><boolProp name="Assertion.assume_success">false</boolProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Report has expected fields" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def response = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()); if (!(response instanceof Map) || !response.containsKey('statuses') || !response.containsKey('total')) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage('Report response must contain statuses and total') }</stringProp></JSR223Assertion><hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="SimpleDataWriter" testclass="ResultCollector" testname="Write JTL results" enabled="true"><boolProp name="ResultCollector.error_logging">false</boolProp><stringProp name="filename"></stringProp></ResultCollector><hashTree/>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
